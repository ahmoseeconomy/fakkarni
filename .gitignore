# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
# لوحة الأدمن حزمة جوّه الريبو — و`/build/` فوق مربوطة بالجذر فما بتغطّيهاش.
admin/build/
admin/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Secrets — the Gemini key comes from --dart-define only, never from a tracked file.
# `flutter run --dart-define-from-file=secrets.json` reads this if you keep one.
secrets.json
*.env

# ملف التصميم المضغوط — المفكوك في design/handoff هو المرجع
design/design_handoff.zip
design/*.pdf

# أرشيفات لوجات الـCI وسكربتات التجربة المحلية — ولا حاجة منهم بتاعة الريبو
tools/

# صور العلب لتجربة البرومبت — محلية بس، وعمرها ما تتكوميت.
test/assets/packages/
