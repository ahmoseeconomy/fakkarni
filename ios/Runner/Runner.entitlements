<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- تذكير الجرعة بيتبعت بمستوى Time Sensitive عشان يعدّي أوضاع التركيز.
	     الملف ده نصّ الشرط بس: الشرط التاني إن الـcapability تتفعّل على
	     App ID في بوابة Apple Developer، وإلا الإشعار بيتعامل كعادي في صمت. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
